generator client {
      provider = "prisma-client-js"
}

datasource db {
      provider  = "postgresql"
      url       = env("DATABASE_URL")
      directUrl = env("DIRECT_URL")
}

enum Role {
      USER
      SELLER
}

model User {
      id           String   @id @default(cuid())
      email        String   @unique
      passwordHash String
      name         String?
      role         Role     @default(USER)
      createdAt    DateTime @default(now())
      updateAt     DateTime @updatedAt
}
