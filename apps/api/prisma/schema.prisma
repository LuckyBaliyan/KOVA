generator client {
      provider = "prisma-client-js"
}

datasource db {
      provider  = "postgresql"
      url       = env("DATABASE_URL")
      directUrl = env("DIRECT_URL")
}

enum Role {
      BUYER
      SELLER
}

model User {
      id           String   @id @default(cuid())
      email        String   @unique
      passwordHash String?
      googleId     String?  @unique
      avatarUrl    String?
      name         String?
      phone        String?
      role         Role     @default(BUYER)
      createdAt    DateTime @default(now())
      updateAt     DateTime @updatedAt
}
